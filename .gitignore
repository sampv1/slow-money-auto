# Environment secrets
scripts/.env
dashboard/.env.local
# Claude Code local settings — the permission allowlist accumulates pasted
# commands, including ones carrying REVALIDATE_SECRET. Never commit it.
.claude/settings.local.json

# Scratch file of hand-run commands — holds pasted secrets (revalidate URLs etc.)
scripts/.manual_cmds

# Python
__pycache__/
*.pyc
.venv/
scripts/.venv/

# Script outputs (Claude API responses)
scripts/outputs/

# Node / Next.js
dashboard/node_modules/
dashboard/.next/
dashboard/out/

# OS
.DS_Store
